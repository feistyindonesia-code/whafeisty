{
  "name": "whafeistyapp",
  "version": "1.0.0",
  "description": "WhatsApp API Unofficial - Multi-tenant System",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon src/app.ts",
    "build": "tsc && tsc -p tsconfig.migrations.json",
    "start": "node dist/app.js",
    "migrate": "npm run build && node dist-migrations/migrations/run.js",
    "create-superadmin": "ts-node scripts/create-superadmin.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "baileys": "^6.0.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.6.0",
    "nodemailer": "^10.1.7",
    "pino": "^8.15.0",
    "qrcode": "^1.5.0",
    "socket.io": "^4.7.0",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0"
  }
}
